{
  "info": {
    "name": "Tarea U2 · Biblioteca (PostgreSQL + MongoDB)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Corre la colección completa con Run collection. Cambia las variables email, password y loginPath si tu login es distinto."
  },
  "item": [
    {
      "name": "0. Login",
      "item": [
        {
          "name": "Login (obtiene el token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login responde 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "const token = j.token || j.accessToken || j.access_token;",
                  "pm.test(\"Devuelve un token\", () => pm.expect(token).to.be.a(\"string\").and.not.empty);",
                  "pm.collectionVariables.set(\"token\", token);",
                  "// ISBN nuevos en cada corrida para poder repetir la colección",
                  "const rnd = () => \"978\" + String(Math.floor(1000000000 + Math.random() * 8999999999));",
                  "pm.collectionVariables.set(\"isbn\", rnd());",
                  "pm.collectionVariables.set(\"isbn2\", rnd());"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}{{loginPath}}",
              "host": [
                "{{baseUrl}}{{loginPath}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
