// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  password     String
  role         Role
  appointments Appointment[]
  prestamos    Prestamo[]
}

model Appointment {
  id          Int       @id @default(autoincrement())
  date        DateTime
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  timeBlock   TimeBlock @relation(fields: [timeBlockId], references: [id])
  timeBlockId Int
}

model TimeBlock {
  id           Int           @id @default(autoincrement())
  startTime    DateTime
  endTime      DateTime
  appointments Appointment[]
}

model Prestamo {
  id               Int            @id @default(autoincrement())
  userId           Int
  user             User           @relation(fields: [userId], references: [id])
  libroId          String? // _id de MongoDB (24 hex), sin FK
  fechaPrestamo    DateTime       @default(now())
  fechaVencimiento DateTime
  fechaDevolucion  DateTime? // null = préstamo activo
  estado           EstadoPrestamo @default(ACTIVO)

  @@index([libroId])
  @@index([userId])
}

enum Role {
  ADMIN
  USER
}

enum EstadoPrestamo {
  ACTIVO
  DEVUELTO
}